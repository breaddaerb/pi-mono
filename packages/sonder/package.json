{
	"name": "@mariozechner/pi-sonder",
	"version": "0.52.9",
	"description": "Telegram-first conversational personal knowledge system",
	"type": "module",
	"bin": {
		"sonder": "dist/main.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": ["dist", "README.md"],
	"scripts": {
		"clean": "rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && chmod +x dist/main.js",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@mariozechner/pi-agent-core": "^0.52.9",
		"@mariozechner/pi-ai": "^0.52.9"
	},
	"devDependencies": {
		"@types/node": "^24.3.0",
		"typescript": "^5.7.3",
		"vitest": "^3.2.4"
	},
	"keywords": ["telegram", "agent", "knowledge", "snapshot"],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/badlogic/pi-mono.git",
		"directory": "packages/sonder"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
